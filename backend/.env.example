PORT=5000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# Replace <username>/<password> and keep a database name (giftnest) before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giftnest?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origins, comma-separated: your deployed frontend and the local dev server.
# Example: https://giftnest.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Image uploads (admin product photos). Required on Vercel because serverless disks are not permanent.
# Create a free account at https://cloudinary.com, then copy these from its dashboard.
# Locally you can leave them empty: photos are saved to backend/uploads instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Store administrator, created by "npm run admin". Choose your own password (8+ characters).
ADMIN_EMAIL=giftnest@admin.com
ADMIN_PASSWORD=
