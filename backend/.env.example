PORT=5000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string.
# Replace <username>/<password> and keep a database name (giftnest) before the "?".
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/giftnest?retryWrites=true&w=majority

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origins, comma-separated (local React dev server + your deployed frontend)
CLIENT_URL=http://localhost:5173

# Store administrator, created by "npm run admin". Choose your own password (8+ characters).
ADMIN_EMAIL=giftnest@admin.com
ADMIN_PASSWORD=
